# Auth0 server-side session configuration for Savant.
# The current Auth0 application is configured only for https://savantrepo.com.
# If you want to test a different origin locally, add its callback/logout URLs in Auth0 first.

# Optional but recommended for a single stable production domain.
# If omitted, Savant can fall back to NEXT_PUBLIC_APP_URL, VERCEL_PROJECT_PRODUCTION_URL,
# VERCEL_URL, or the request host at runtime.
APP_BASE_URL=https://savantrepo.com
AUTH0_DOMAIN=dev-uzaxp03ophsygo6g.us.auth0.com
AUTH0_CLIENT_ID=SIITci8080F0O0aNSoVEjAaDqTpsO7q5
# Optional public aliases supported by the deployment diagnostics and runtime normalization.
# Useful when your hosting platform only exposes these values to the frontend bundle by default.
# NEXT_PUBLIC_AUTH0_DOMAIN=dev-uzaxp03ophsygo6g.us.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=SIITci8080F0O0aNSoVEjAaDqTpsO7q5
# NEXT_PUBLIC_AUTH0_ISSUER_BASE_URL=https://dev-uzaxp03ophsygo6g.us.auth0.com
AUTH0_CLIENT_SECRET=<AUTH0_CLIENT_SECRET>
# 64 hex characters generated with: openssl rand -hex 32
AUTH0_SECRET=<AUTH0_SECRET_HEX_64_CHARS>

# Required for durable production onboarding, tenant provisioning, webhook-backed
# Auth0/Stripe correlation, and BYO-AI connection persistence. Apply
# db/schema/0001_control_plane.sql, db/schema/0002_onboarding.sql,
# db/schema/0003_multitenancy.sql, db/schema/0004_ai_connections.sql,
# db/schema/0005_skill_intelligence.sql, and db/schema/0006_git_provider_integration.sql
# to this database.
DATABASE_URL=<DATABASE_URL>

# Source control (Settings → Source control). Apply db/schema/0006_git_provider_integration.sql.
# Users connect providers from the UI; no per-tenant tokens, env vars, or SQL rows are needed.
#
# 32-byte key (64 hex chars or base64) that encrypts provider credentials at rest.
# Keep it in the deployment secret store, never in the database.
# Generate with: openssl rand -base64 32
GIT_CREDENTIAL_ENCRYPTION_KEY=<GIT_CREDENTIAL_ENCRYPTION_KEY>
# Optional previous key, accepted for decryption during key rotation.
# GIT_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=<GIT_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS>
# Optional override for the origin used in provider redirect URIs (defaults to APP_BASE_URL).
# Callback URIs are <origin>/api/git/connections/<github|gitlab|bitbucket|azure>/callback.
# GIT_OAUTH_REDIRECT_BASE_URL=https://savantrepo.com
#
# GitHub App (read-only: Contents: Read, Metadata: Read). Set the app's Setup URL and Callback URL
# to the GitHub callback above and enable "Request user authorization (OAuth) during installation".
GITHUB_APP_ID=<GITHUB_APP_ID>
GITHUB_APP_SLUG=<GITHUB_APP_SLUG>
GITHUB_APP_CLIENT_ID=<GITHUB_APP_CLIENT_ID>
GITHUB_APP_CLIENT_SECRET=<GITHUB_APP_CLIENT_SECRET>
# PEM private key; literal "\n" sequences are accepted.
GITHUB_APP_PRIVATE_KEY=<GITHUB_APP_PRIVATE_KEY>
# GitLab.com OAuth application (scopes: read_repository read_api read_user).
# Self-managed GitLab instances are connected with an OAuth app registered on that instance.
GITLAB_OAUTH_CLIENT_ID=<GITLAB_OAUTH_CLIENT_ID>
GITLAB_OAUTH_CLIENT_SECRET=<GITLAB_OAUTH_CLIENT_SECRET>
# Bitbucket Cloud OAuth client (Workspace settings → OAuth clients) with only Account: Read,
# Workspace membership: Read and Repositories: Read; grant types Authorization code + Refresh token.
BITBUCKET_OAUTH_CLIENT_ID=<BITBUCKET_OAUTH_CLIENT_ID>
BITBUCKET_OAUTH_CLIENT_SECRET=<BITBUCKET_OAUTH_CLIENT_SECRET>
# Azure Repos via Microsoft Entra ID (delegated Azure DevOps vso.code permission).
AZURE_DEVOPS_ENTRA_CLIENT_ID=<AZURE_DEVOPS_ENTRA_CLIENT_ID>
AZURE_DEVOPS_ENTRA_CLIENT_SECRET=<AZURE_DEVOPS_ENTRA_CLIENT_SECRET>
# AZURE_DEVOPS_ENTRA_TENANT=organizations
# Hostnames of private self-managed providers that Savant may reach on purpose (SSRF allowlist).
# GIT_PROVIDER_ALLOWED_PRIVATE_HOSTS=gitlab.internal.example
# Sync safeguards (defaults shown).
# GIT_SYNC_MAX_TREE_ENTRIES=50000
# GIT_SYNC_MAX_FILE_BYTES=1048576
# GIT_SYNC_MAX_TOTAL_BYTES=26214400
# GIT_SYNC_MAX_SKILLS=1000
# GIT_SYNC_MAX_DEPTH=12

# LEGACY (migration only): deployment-managed repository write configuration.
# Existing git_provider_connections rows with credentials_ref keep working (auth_type = 'legacy_env')
# for reads until reauthorized, and remain the only path for repository write operations.
# Do not create new legacy rows for read access; use Settings → Source control instead.
# Store the ENV VAR NAME in git_provider_connections.credentials_ref, not the token itself.
# Example row: credentials_ref = 'GITHUB_WRITE_TOKEN'
# Use a GitHub access token that can create repositories and commit content for the target org.
GITHUB_WRITE_TOKEN=<GITHUB_WRITE_TOKEN>
# Optional extra per-tenant/provider tokens can use distinct env var names referenced from the DB.
# GITHUB_WRITE_TOKEN_FINANCE=<GITHUB_WRITE_TOKEN_FINANCE>

# 32-byte secret used to encrypt tenant BYO-AI API keys before they are written
# into Savant's server-side encrypted vault table. Accepts either 64 hex chars
# or standard base64 for 32 raw bytes.
# Generate with: openssl rand -base64 32
AI_CONNECTION_ENCRYPTION_KEY=<AI_CONNECTION_ENCRYPTION_KEY>

# Optional public app origin override for onboarding + hosted checkout.
# Savant also uses this as a fallback Auth0 app base URL when APP_BASE_URL is unset.
NEXT_PUBLIC_APP_URL=<NEXT_PUBLIC_APP_URL>

# Optional local onboarding sandbox for development-only click-through testing.
# When enabled, Savant simulates Auth0 identity and hosted checkout so you can
# test the onboarding flow locally without live providers.
ONBOARDING_DEV_SANDBOX=0
# Optional overrides for the synthetic sandbox identity.
ONBOARDING_SANDBOX_SUBJECT=dev-sandbox|local-user
ONBOARDING_SANDBOX_EMAIL=local@savant.dev
ONBOARDING_SANDBOX_NAME=Local Sandbox User
# Optional sandbox checkout result: success | cancel | fail
ONBOARDING_DEV_SANDBOX_OUTCOME=success

# Stripe billing configuration for apps/web/.env.local or your deployment env.
# Savant uses a single "Savant Seat" product for every customer.
# Hosted checkout works with just STRIPE_SECRET_KEY; price ids are optional.
# For the fastest unblock, configure a native Stripe pricing table and embed it
# in onboarding with NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID plus the publishable key.
# Set the pricing table's success URL to:
#   https://savantrepo.com/onboarding/success?session_id={CHECKOUT_SESSION_ID}
# and the cancel URL to:
#   https://savantrepo.com/onboarding?cancelled=1
# The seat pricing is $1 / seat / month and $10 / seat / year.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY>
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=<NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID>
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_PRICE_ID_MONTHLY=<STRIPE_PRICE_ID_MONTHLY>
STRIPE_PRICE_ID_YEARLY=<STRIPE_PRICE_ID_YEARLY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Shared secret used to verify GitHub and GitLab repository webhook deliveries.
# Generate with: openssl rand -hex 32
REPOSITORY_WEBHOOK_SECRET=<REPOSITORY_WEBHOOK_SECRET>

# Skill Intelligence: 32-byte key (64 hex chars or base64) used to encrypt
# redacted run inputs/outputs/trajectories at rest. Without it, runs are stored
# as outcome-only telemetry and no payloads are persisted.
# Generate with: openssl rand -base64 32
TELEMETRY_ENCRYPTION_KEY=<TELEMETRY_ENCRYPTION_KEY>

# Shared secret for the Skill Intelligence worker (services/skill-intelligence)
# calling /api/internal/*. At least 16 characters. The worker needs no DB access.
# Generate with: openssl rand -hex 32
SAVANT_WORKER_TOKEN=<SAVANT_WORKER_TOKEN>

# SEO / GEO / AEO (docs/operations/seo-geo-aeo.md). Only VERCEL_ENV=production is
# indexable; set SAVANT_SEO_INDEXING=0 to keep production dark, 1 to force indexing.
# SAVANT_SEO_INDEXING=
# Search console ownership tokens (meta tag values only, not the whole tag).
# GOOGLE_SITE_VERIFICATION=<GOOGLE_SITE_VERIFICATION>
# BING_SITE_VERIFICATION=<BING_SITE_VERIFICATION>
# IndexNow key served at /indexnow.txt. Generate with: openssl rand -hex 16
# INDEXNOW_KEY=<INDEXNOW_KEY>

# ── Evaluation generation and skill safety ────────────────────────────────
# NVIDIA NIM (OpenAI-compatible): drafts evaluation cases and executes skills on them.
NVIDIA_NIM_API_KEY=<NVIDIA_NIM_API_KEY>
# NIM_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_EXECUTION_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_USD_PER_MTOK=0.5
# TypeSafe Jev: validates drafted cases and scores outputs (System One judge).
JEV_API_KEY=<JEV_API_KEY>
# JEV_MODEL=jev-latest
# Skills without a scored dataset that get evaluations generated per sync (0 disables).
# EVAL_GENERATION_AUTO_LIMIT=3
# NVIDIA SkillSpector safety scans run in a Vercel Sandbox after each sync.
# SKILLSPECTOR_ENABLED=1
# LLM semantic pass (via NIM): off | flagged (default: packages the static scan flagged) | all
# SKILLSPECTOR_LLM=flagged
# SKILLSPECTOR_LLM_LIMIT=5
# Background job runner: time budget per invocation, and a token for /api/internal/jobs/run.
# BACKGROUND_JOBS_BUDGET_MS=230000
# SAVANT_WORKER_TOKEN=<SAVANT_WORKER_TOKEN>

# ── Public skill catalog ──────────────────────────────────────────────────
# Sources are rows in skill_hub_sources (seeded by 0010). skills.sh uses the
# deployment's Vercel OIDC token automatically.
# GITHUB_PUBLIC_TOKEN=<read-only token; raises GitHub's 60/hour anonymous limit>
# SKILLSMP_API_KEY=<optional; raises SkillsMP's 50/day anonymous limit>
# Live (LLM↔Jev) evaluations queued per source sync; 0 disables.
# HUB_AUTO_EVAL_LIMIT=3
# Vercel Cron authenticates to /api/internal/* with this Bearer token.
# CRON_SECRET=<CRON_SECRET>
